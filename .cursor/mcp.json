{
  "mcpServers": {
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase@latest",
        "--project-ref=<YOUR_PROJECT_REF>",
        "--write"        // ← add this flag to enable write operations
      ],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "<YOUR_PAT>"
      }
    }
  }
}
